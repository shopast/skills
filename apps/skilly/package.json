{
  "name": "skilly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3065",
    "build": "vite build",
    "preview": "vite preview --port 3065",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:run": "vitest run",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && pnpm exec wrangler deploy"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "@vercel/oidc": "^3.8.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22.18.0",
    "js-yaml": "^4.1.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.131.2"
  }
}
